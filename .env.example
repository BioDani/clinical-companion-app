# Hugging Face token for the router (LangChain ChatOpenAI).
# Create one at https://huggingface.co/settings/tokens — it must start with hf_
HF_TOKEN=

# Optional override (default: Qwen/Qwen3-4B-Instruct-2507)
# HF_MODEL=Qwen/Qwen3-4B-Instruct-2507

# Optional ebook embedding model. The ebook and the search keywords are Spanish.
# HF_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Weaviate host for the ebook index. Compose sets this to the weaviate service.
# A local agent outside Compose uses localhost.
# WEAVIATE_HOST=localhost

# Tavily key for web search when the ebook does not cover the question.
# Create one at https://tavily.com
TAVILY_API_KEY=

# Shared HS256 secret for rbac (issues tokens) and agent (verifies them).
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
# Local compose mints one Open WebUI token at boot; keep it long enough for a lab day.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# First rbac init only. Change the password before any non-local use.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
