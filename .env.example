# Hugging Face token for Inference Providers (smolagents InferenceClientModel).
# Create one at https://huggingface.co/settings/tokens — it must start with hf_
HF_TOKEN=replace-me-with-a-hf-token

# Optional override (default: Qwen/Qwen2.5-72B-Instruct)
# HF_MODEL=Qwen/Qwen2.5-72B-Instruct

# Embedding model for Weaviate ingestion and retrieval (Hugging Face Inference API).
# HF_EMBEDDING_MODEL=intfloat/multilingual-e5-large

# Weaviate vector database for RAG citation-aware retrieval.
WEAVIATE_URL=http://weaviate:8080
WEAVIATE_API_KEY=
WEAVIATE_ADMIN_PASSWORD=admin
WEAVIATE_COLLECTION_NAME=AgenticDocuments

# Tavily key for web search when the ebook does not cover the question.
# Create one at https://tavily.com
TAVILY_API_KEY=

# Shared HS256 secret for rbac (issues tokens) and agent (verifies them).
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
# Local compose mints one Open WebUI token at boot; keep it long enough for a lab day.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# First rbac init only. Change the password before any non-local use.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
