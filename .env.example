# Hugging Face token for the router (LangChain ChatOpenAI).
# Create one at https://huggingface.co/settings/tokens — it must start with hf_
HF_TOKEN=

# Optional override (default: Qwen/Qwen3-4B-Instruct-2507)
# HF_MODEL=Qwen/Qwen3-4B-Instruct-2507

# Optional ebook embedding model. The ebook and the search keywords are Spanish.
# HF_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Weaviate host for the ebook index. Compose sets this to the weaviate service.
# A local agent outside Compose uses localhost.
# WEAVIATE_HOST=localhost

# Tavily key for web search when the ebook does not cover the question.
# Create one at https://tavily.com
TAVILY_API_KEY=

# Shared HS256 secret for rbac (issues tokens) and agent (verifies them).
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
# Local compose mints one Open WebUI token at boot; keep it long enough for a lab day.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# First rbac init only. Change the password before any non-local use.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Local Langfuse UI: http://localhost:3001
# ENCRYPTION_KEY must be 64 hex characters: openssl rand -hex 32
# NEXTAUTH_SECRET and SALT: openssl rand -base64 32
# Postgres, ClickHouse, Redis, and MinIO passwords are placed in connection
# settings. Use letters, numbers, hyphen, and underscore only.
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_AUTH=
LANGFUSE_MINIO_ROOT_PASSWORD=

# Headless init on first Langfuse boot.
# Keys use the shape Langfuse generates: pk-lf-<uuid> and sk-lf-<uuid>.
# Compose gives this same pair to the agent. A host-side agent reads
# LANGFUSE_PUBLIC_KEY and LANGFUSE_SECRET_KEY instead; set those to the same values.
LANGFUSE_INIT_ORG_ID=clinical-companion
LANGFUSE_INIT_ORG_NAME=Clinical Companion
LANGFUSE_INIT_PROJECT_ID=clinical-companion
LANGFUSE_INIT_PROJECT_NAME=Clinical Companion
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=

# Host-side agent only. Compose sets the agent to http://langfuse-web:3000.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3001
